# Postgres connection used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/beldexdb?schema=public"

# Brevo transactional email
# Create a new API key in Brevo and keep it only in .env
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="wallet@example.com"
BREVO_SENDER_NAME="Beldex Wallet"

# OTP behavior
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# resent after 60 secs
OTP_RESEND_COOLDOWN_SECONDS=60 

# security checks
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_IP_MAX_REQUESTS_PER_HOUR=10
