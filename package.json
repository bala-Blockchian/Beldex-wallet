{
  "name": "beldex-wallet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:wasm": "mkdir -p public/assets && cp node_modules/@bdxi/beldex-app-bridge/BeldexLibAppCpp_WASM.wasm public/assets/",
    "dev": "bun run sync:wasm && concurrently -k -n server,client -c blue,green \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun --hot server/index.ts",
    "build": "bun run sync:wasm && tsc -b && vite build",
    "start": "bun run server/index.ts",
    "preview": "bun run sync:wasm && vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:studio": "bunx prisma studio"
  },
  "dependencies": {
    "@bdxi/beldex-app-bridge": "^3.0.2",
    "@bdxi/beldex-nettype": "^1.0.0",
    "@prisma/client": "6.19.3",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "prisma": "6.19.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
